# =====================================================================
# Plantilla de configuracion. Copiar a .env y completar.
#
#     cp .env.example .env
#
# El .env NO se versiona: lleva la clave de la base de datos.
# =====================================================================

# ---------------------------------------------------------------------
# Entorno: production | local
#
# En production los errores van al log y nunca a pantalla.
# Si se deja vacio se adivina por el host (127.0.0.1 y localhost son local).
# ---------------------------------------------------------------------
APP_ENV=production

# ---------------------------------------------------------------------
# Acceso sin login. SOLO PARA PRUEBAS.
#
# true  = se entra directo, sin usuario ni contrasena.
# false = se exige login (comportamiento normal).
#
# Con esto en true cualquiera que llegue a la URL ve costos, margenes y
# la cartera de clientes. Mientras este activo la aplicacion muestra una
# cinta roja en todas las pantallas para que no quede encendido por olvido.
# ---------------------------------------------------------------------
APP_ACCESO_LIBRE=true

# ---------------------------------------------------------------------
# Base de datos
#
# En cPanel el nombre de la base y del usuario llevan el prefijo de la
# cuenta, por ejemplo enlixpe_cotizacion.
#
# Si la clave tiene espacios, comillas o "#", ponerla entre comillas:
#     DB_PASS="mi=clave#rara"
# ---------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=CUENTA_cotizacion
DB_USER=CUENTA_usuario
# La clave va SOLO en el .env real, nunca en esta plantilla:
# .env.example si se versiona, y el repositorio es publico.
DB_PASS="PEGAR-AQUI-LA-CLAVE-EN-EL-.ENV-REAL"
