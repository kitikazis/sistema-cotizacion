# Rutas relativas a la raiz del repo. El modulo se movio de
# cotizaciones-module/ a la raiz para que index.php quede en el document
# root del subdominio en cPanel.

# Configuracion del entorno: lleva la clave de la base de datos y el
# interruptor del acceso sin login. Usar .env.example como plantilla.
/.env

# Dependencias de Composer (se reinstalan con `composer install`)
/vendor/

# config/empresa.php SI se versiona, por pedido expreso: son datos fijos de
# Enlix y asi vienen por defecto en cada despliegue sin configurar nada.
# Ojo: el repositorio es publico, de modo que las cuentas bancarias, el
# correo y el celular del gerente quedan visibles. Para revertirlo, volver
# a ignorarlo aqui y ejecutar: git rm --cached config/empresa.php

# Firma escaneada del gerente. Fuera del repo a proposito: con ella se puede
# falsificar un documento firmado. Se copia a mano en cada instalacion; si
# falta, el PDF se genera igual pero sin firma.
/pdf/firma*.png

# PDFs generados en tiempo de ejecucion
/storage/*.pdf

# Sistema operativo
Thumbs.db
Desktop.ini
.DS_Store

# Editores
.vscode/
.idea/
*.swp
